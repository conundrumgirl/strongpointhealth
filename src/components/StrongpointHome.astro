---
const pillars = [
  {
    number: '01 / STRENGTH',
    title: 'Build capacity',
    description: 'Resistance training, movement quality, and the foundations of lasting physical strength.'
  },
  {
    number: '02 / PERFORMANCE',
    title: 'Keep moving',
    description: 'Endurance, recovery, adaptation, and the satisfaction of continuing to explore.'
  },
  {
    number: '03 / LONGEVITY',
    title: 'Age with intention',
    description: 'Healthy aging, sustainable habits, and the science of maintaining physical capacity.'
  }
];
---
<header class="shell site-header">
  <a class="brand" href="/" aria-label="Strongpoint Health home">
    <img src="/images/strongpoint-mark.png" alt="" />
    <span class="brand-copy">
      <span class="brand-name">STRONGPOINT</span>
      <span class="brand-sub">HEALTH</span>
    </span>
  </a>
  <nav aria-label="Main navigation">
    <a href="#about">About</a>
    <a href="#focus">Focus</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<main>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">A personal perspective on wellbeing</div>
      <h1>Strength.<br />Movement.<br />Longevity.</h1>
      <p class="intro">Exploring the relationship between physical performance, healthy aging, and the habits that help us live well.</p>
      <a class="cta" href="#about">Discover the approach <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-art">
      <img
        src="/images/alpine-hero-art.jpg"
        alt="Painterly view of a hiker on a rocky alpine summit overlooking a mountain range"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="manifesto shell" id="about">
    <div>
      <div class="eyebrow manifesto-eyebrow">The idea</div>
      <h2>Build strength<br />for the long run.</h2>
    </div>
    <p>Strongpoint Health is a personal exploration of strength, movement, and longevity. It brings together an enduring interest in resistance training and distance running, a background in acupuncture, and an analytical curiosity about how we move, adapt, and age. The goal is not quick fixes, but a thoughtful, evidence-informed approach to staying capable and engaged in life.</p>
  </section>

  <section class="shell pillars" id="focus" aria-label="Areas of focus">
    {pillars.map((pillar) => (
      <article class="pillar">
        <div class="number">{pillar.number}</div>
        <h3>{pillar.title}</h3>
        <p>{pillar.description}</p>
      </article>
    ))}
  </section>
</main>

<footer id="contact">
  <div class="shell foot">
    <small>STRONGPOINT HEALTH&nbsp; · &nbsp;STRENGTH. MOVEMENT. LONGEVITY.</small>
    <a href="mailto:alina.gendel@gmail.com">Get in touch ↗</a>
  </div>
</footer>

<style>
  .shell { width: min(1180px, calc(100% - 56px)); margin-inline: auto; }
  .site-header { height: 88px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: flex; align-items: center; gap: 13px; }
  .brand img { width: 66px; height: auto; display: block; }
  .brand-copy { display: flex; flex-direction: column; }
  .brand-name { font-size: 14px; font-weight: 700; letter-spacing: .22em; }
  .brand-sub { font-size: 9px; letter-spacing: .42em; color: var(--sage); margin-top: 5px; }
  nav { display: flex; gap: 34px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  nav a { opacity: .78; transition: color .2s, opacity .2s; }
  nav a:hover { opacity: 1; color: var(--clay); }
  .hero { min-height: 590px; background: var(--ink); color: var(--paper); display: grid; grid-template-columns: .9fr 1.1fr; overflow: hidden; }
  .hero-copy { padding: 80px max(42px, calc((100vw - 1180px) / 2)) 76px max(42px, calc((100vw - 1180px) / 2)); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .eyebrow { font-size: 10px; letter-spacing: .28em; text-transform: uppercase; color: var(--sage-light); font-weight: 600; }
  h1 { font: clamp(48px, 5.3vw, 76px)/.99 'DM Serif Display', serif; font-weight: 400; letter-spacing: -.035em; margin: 24px 0 20px; max-width: 560px; }
  .intro { font-size: 16px; line-height: 1.8; color: #d2dcda; max-width: 420px; margin: 0 0 32px; }
  .cta { border: 1px solid var(--sage-light); padding: 14px 20px; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; transition: .2s; }
  .cta:hover { background: var(--sage-light); color: var(--ink); }
  .hero-art { min-height: 590px; position: relative; background: #637b83; }
  .hero-art img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: 43% center; }
  .hero-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(23,42,51,.15), transparent 40%); pointer-events: none; }
  .manifesto { padding: 92px 0 82px; display: grid; grid-template-columns: .7fr 1.3fr; gap: 70px; align-items: start; }
  .manifesto h2 { font: 40px/1.1 'DM Serif Display', serif; font-weight: 400; margin: 0; }
  .manifesto p { font-size: 16px; line-height: 1.9; color: #53666a; margin: 0; max-width: 680px; }
  .manifesto-eyebrow { color: var(--clay); margin-bottom: 12px; }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; padding: 0 0 92px; }
  .pillar { padding: 24px 30px 10px 0; border-top: 2px solid var(--sage); }
  .pillar + .pillar { padding-left: 30px; border-left: 1px solid #d2dbd6; }
  .number { font-size: 10px; letter-spacing: .2em; color: var(--clay); }
  .pillar h3 { font: 26px 'DM Serif Display', serif; font-weight: 400; margin: 17px 0 10px; }
  .pillar p { font-size: 13px; line-height: 1.8; color: #617276; margin: 0; max-width: 270px; }
  footer { background: var(--ink); color: #eaf0ed; padding: 34px 0; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .foot small { font-size: 10px; letter-spacing: .12em; color: #bdcbc5; }
  .foot a { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 760px) {
    .shell { width: min(calc(100% - 36px), 600px); }
    .site-header { height: 76px; }
    .brand img { width: 54px; }
    nav { gap: 15px; font-size: 9px; }
    .hero { grid-template-columns: 1fr; }
    .hero-copy { padding: 54px 28px 58px; order: 1; }
    .hero-art { min-height: 360px; order: 0; }
    h1 { font-size: 54px; }
    .manifesto { padding: 64px 0; grid-template-columns: 1fr; gap: 20px; }
    .manifesto h2 { font-size: 36px; }
    .pillars { grid-template-columns: 1fr; padding-bottom: 64px; }
    .pillar, .pillar + .pillar { padding: 22px 0; border-left: 0; border-top: 1px solid #d2dbd6; }
    .pillar:first-child { border-top: 2px solid var(--sage); }
    .foot { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 390px) {
    .brand { gap: 8px; }
    .brand img { width: 45px; }
    .brand-name { font-size: 11px; }
    nav { gap: 10px; font-size: 8px; }
  }
</style>
